<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice conversation with the AI (asked at runtime only when the customer opens the voice screen). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- RECORD_AUDIO alone makes the stores require a microphone, which hides the app on TVs (and other devices)
         without one. The voice is optional: with no microphone the SDK offers the phone by QR or the text chat. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application>
        <activity
            android:name="com.oryksa.sdk.OryksaChatActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <!-- The camera of the attach button saves the photo here (the app's cache), then the SDK sends it. -->
        <provider
            android:name="com.oryksa.sdk.OryksaFileProvider"
            android:authorities="${applicationId}.oryksa.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/oryksa_file_paths" />
        </provider>
    </application>
</manifest>
